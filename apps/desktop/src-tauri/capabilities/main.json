{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Ventana principal: comandos de la app y escucha de eventos (drag & drop)",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-subscribe",
    "allow-prompt-answer",
    "allow-hosts-list",
    "allow-host-save",
    "allow-host-delete",
    "allow-hosts-import-ssh-config",
    "allow-term-open",
    "allow-term-write",
    "allow-term-resize",
    "allow-term-close",
    "allow-conn-open",
    "allow-conn-close",
    "allow-sftp-open",
    "allow-local-root",
    "allow-local-pick-root",
    "allow-fs-list",
    "allow-fs-mkdir",
    "allow-fs-rename",
    "allow-fs-remove",
    "allow-xfer-enqueue",
    "allow-xfer-upload-paths",
    "allow-xfer-cancel",
    "allow-xfer-pause",
    "allow-keys-list",
    "allow-key-generate",
    "allow-key-import",
    "allow-key-install",
    "allow-snippets-list",
    "allow-snippets-save",
    "allow-fwd-list",
    "allow-fwd-start",
    "allow-fwd-stop",
    "allow-settings-get",
    "allow-settings-save",
    "allow-open-url",
    "allow-serial-ports",
    "allow-pick-identity-file",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
